+
+#ifndef HARDWARE_DECKARD_CAMERA_HOSTCAMERA_H_
+#define HARDWARE_DECKARD_CAMERA_HOSTCAMERA_H_
+
+#include <android-base/unique_fd.h>
+#include <utils/Timers.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <vector>
+
+namespace android {
+namespace hardware {
+namespace camera {
+namespace deckard {
+
+// The host's frames: DRM_FORMAT_ABGR8888, bytes R, G, B, A.
+constexpr uint32_t kHostFourcc = 0x34324241;  // 'AB24'
+
+// Frames the HAL may hold at once (the host's FRAMES_OUT).
+constexpr uint32_t kHostFrames = 2;
+
+struct HostSize {
+    int32_t width;
+    int32_t height;
+    uint32_t fps;
+};
+
+struct HostCameraInfo {
+    uint32_t index;
+    uint8_t facing;  // ANDROID_LENS_FACING_*
+    int32_t rotation;
+    std::vector<HostSize> sizes;
+};
+
+enum class HostError { NONE, BUSY, GONE, BROKEN, INVALID, DISCONNECTED };
+
+struct HostFrameData {
+    uint64_t id;
+    nsecs_t timestamp;
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;
+    uint32_t offset;
+    base::unique_fd fd;
+};
+
+// One connection to deckard-camera (docs/camera.md in Marathon-Deckard). The
+// host's side is host/deckard-camera there; wire.rs holds the messages.
+class HostConnection {
+  public:
+    // Connects and reads the host's cameras; null when the host is not there.
+    static std::shared_ptr<HostConnection> connect();
+    ~HostConnection();
+
+    const std::vector<HostCameraInfo>& cameras() const { return mCameras; }
+
+    // Acquires one camera for this connection.
+    HostError open(uint32_t camera);
+    // Streams at the sensor mode's own rate.
+    HostError start(uint32_t width, uint32_t height);
+    HostError stop();
+
+    // The newest frame the HAL has not taken, waiting up to `timeout`.
+    std::optional<HostFrameData> nextFrame(std::chrono::milliseconds timeout);
+    void release(uint64_t id);
+
+    // Returns once the host has closed the connection.
+    void waitClosed();
+
+  private:
+    explicit HostConnection(base::unique_fd socket);
+    bool readCameras();
+    void readLoop();
+    HostError request(const std::vector<uint8_t>& message);
+    bool send(const std::vector<uint8_t>& message);
+
+    base::unique_fd mSocket;
+    std::vector<HostCameraInfo> mCameras;
+    std::thread mReader;
+    std::mutex mLock;
+    std::condition_variable mCond;
+    std::deque<HostError> mReplies;
+    std::optional<HostFrameData> mPending;
+    bool mClosed = false;
+    bool mFailed = false;
+};
+
+}  // namespace deckard
+}  // namespace camera
+}  // namespace hardware
+}  // namespace android
+
+#endif  // HARDWARE_DECKARD_CAMERA_HOSTCAMERA_H_
