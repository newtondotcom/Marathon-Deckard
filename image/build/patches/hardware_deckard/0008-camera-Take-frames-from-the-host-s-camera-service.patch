+
+#define LOG_TAG "DeckardHostCam"
+
+#include "HostCamera.h"
+
+#include <log/log.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <cinttypes>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+namespace android {
+namespace hardware {
+namespace camera {
+namespace deckard {
+
+namespace {
+
+constexpr char kSocketPath[] = "/data/deckard/camera.sock";
+constexpr auto kReplyTimeout = std::chrono::seconds(10);
+
+constexpr uint32_t kVersion = 1;
+constexpr uint32_t kHello = 1;
+constexpr uint32_t kOpen = 2;
+constexpr uint32_t kStart = 3;
+constexpr uint32_t kStop = 4;
+constexpr uint32_t kRelease = 5;
+constexpr uint32_t kCamera = 101;
+constexpr uint32_t kCamerasEnd = 102;
+constexpr uint32_t kOk = 103;
+constexpr uint32_t kError = 104;
+constexpr uint32_t kFrame = 105;
+constexpr uint32_t kFailed = 106;
+
+constexpr size_t kMaxSizes = 32;
+constexpr size_t kMaxMessage = 16 + kMaxSizes * 12;
+
+uint32_t u32At(const uint8_t* bytes, size_t at) {
+    uint32_t value;
+    memcpy(&value, bytes + at, sizeof(value));
+    return value;
+}
+
+uint64_t u64At(const uint8_t* bytes, size_t at) {
+    uint64_t value;
+    memcpy(&value, bytes + at, sizeof(value));
+    return value;
+}
+
+class Message {
+  public:
+    explicit Message(uint32_t kind) { u32(kind); }
+    Message& u32(uint32_t value) {
+        append(&value, sizeof(value));
+        return *this;
+    }
+    Message& u64(uint64_t value) {
+        append(&value, sizeof(value));
+        return *this;
+    }
+    const std::vector<uint8_t>& bytes() const { return mBytes; }
+
+  private:
+    void append(const void* data, size_t size) {
+        auto* p = static_cast<const uint8_t*>(data);
+        mBytes.insert(mBytes.end(), p, p + size);
+    }
+    std::vector<uint8_t> mBytes;
+};
+
+HostError errorFrom(uint32_t code) {
+    switch (code) {
+        case 1:
+            return HostError::BUSY;
+        case 2:
+            return HostError::GONE;
+        case 4:
+            return HostError::INVALID;
+        default:
+            return HostError::BROKEN;
+    }
+}
+
+// One message and the descriptor it carries; size 0 when the host closed.
+ssize_t receive(int socket, uint8_t* bytes, size_t size, base::unique_fd* fd) {
+    union {
+        cmsghdr align;
+        char buf[CMSG_SPACE(sizeof(int))];
+    } control{};
+    iovec iov{.iov_base = bytes, .iov_len = size};
+    msghdr msg{};
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.buf;
+    msg.msg_controllen = sizeof(control.buf);
+    ssize_t len = TEMP_FAILURE_RETRY(recvmsg(socket, &msg, MSG_CMSG_CLOEXEC));
+    for (cmsghdr* c = CMSG_FIRSTHDR(&msg); c != nullptr; c = CMSG_NXTHDR(&msg, c)) {
+        if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS &&
+            c->cmsg_len == CMSG_LEN(sizeof(int))) {
+            int received;
+            memcpy(&received, CMSG_DATA(c), sizeof(int));
+            fd->reset(received);
+        }
+    }
+    if (len > 0 && (msg.msg_flags & (MSG_TRUNC | MSG_CTRUNC))) {
+        errno = EMSGSIZE;
+        return -1;
+    }
+    return len;
+}
+
+}  // namespace
+
+std::shared_ptr<HostConnection> HostConnection::connect() {
+    base::unique_fd socket(::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0));
+    if (socket.get() < 0) {
+        return nullptr;
+    }
+    sockaddr_un addr{.sun_family = AF_UNIX};
+    strlcpy(addr.sun_path, kSocketPath, sizeof(addr.sun_path));
+    if (TEMP_FAILURE_RETRY(::connect(socket.get(), reinterpret_cast<sockaddr*>(&addr),
+                                     sizeof(addr))) != 0) {
+        ALOGV("%s: %s: %s", __FUNCTION__, kSocketPath, strerror(errno));
+        return nullptr;
+    }
+    std::shared_ptr<HostConnection> connection(new HostConnection(std::move(socket)));
+    if (!connection->readCameras()) {
+        return nullptr;
+    }
+    connection->mReader = std::thread([raw = connection.get()] { raw->readLoop(); });
+    return connection;
+}
+
+HostConnection::HostConnection(base::unique_fd socket) : mSocket(std::move(socket)) {}
+
+HostConnection::~HostConnection() {
+    shutdown(mSocket.get(), SHUT_RDWR);
+    if (mReader.joinable()) {
+        mReader.join();
+    }
+}
+
+bool HostConnection::send(const std::vector<uint8_t>& message) {
+    return TEMP_FAILURE_RETRY(::send(mSocket.get(), message.data(), message.size(),
+                                     MSG_NOSIGNAL)) == static_cast<ssize_t>(message.size());
+}
+
+bool HostConnection::readCameras() {
+    timeval timeout{.tv_sec = 5};
+    setsockopt(mSocket.get(), SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    if (!send(Message(kHello).u32(kVersion).bytes())) {
+        return false;
+    }
+    uint8_t bytes[kMaxMessage];
+    while (true) {
+        base::unique_fd unexpected;
+        ssize_t len = receive(mSocket.get(), bytes, sizeof(bytes), &unexpected);
+        if (len < 4) {
+            ALOGE("%s: no camera list from the host: %s", __FUNCTION__,
+                  len < 0 ? strerror(errno) : "closed");
+            return false;
+        }
+        uint32_t kind = u32At(bytes, 0);
+        if (kind == kCamerasEnd) {
+            break;
+        }
+        if (kind != kCamera || len < 20) {
+            ALOGE("%s: unexpected message %u", __FUNCTION__, kind);
+            return false;
+        }
+        uint32_t count = u32At(bytes, 16);
+        if (count > kMaxSizes || static_cast<size_t>(len) != 20 + count * 12) {
+            ALOGE("%s: malformed camera", __FUNCTION__);
+            return false;
+        }
+        HostCameraInfo info{.index = u32At(bytes, 4),
+                            .facing = static_cast<uint8_t>(u32At(bytes, 8)),
+                            .rotation = static_cast<int32_t>(u32At(bytes, 12) % 360)};
+        for (uint32_t i = 0; i < count; i++) {
+            size_t at = 20 + i * 12;
+            info.sizes.push_back({.width = static_cast<int32_t>(u32At(bytes, at)),
+                                  .height = static_cast<int32_t>(u32At(bytes, at + 4)),
+                                  .fps = u32At(bytes, at + 8)});
+        }
+        mCameras.push_back(std::move(info));
+    }
+    timeout.tv_sec = 0;
+    setsockopt(mSocket.get(), SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    return true;
+}
+
+void HostConnection::readLoop() {
+    uint8_t bytes[kMaxMessage];
+    while (true) {
+        base::unique_fd fd;
+        ssize_t len = receive(mSocket.get(), bytes, sizeof(bytes), &fd);
+        if (len < 4) {
+            if (len < 0) {
+                ALOGE("%s: %s", __FUNCTION__, strerror(errno));
+            }
+            break;
+        }
+        uint32_t kind = u32At(bytes, 0);
+        std::lock_guard<std::mutex> lk(mLock);
+        if (kind == kOk && len == 4) {
+            mReplies.push_back(HostError::NONE);
+        } else if (kind == kError && len == 8) {
+            mReplies.push_back(errorFrom(u32At(bytes, 4)));
+        } else if (kind == kFailed && len == 4) {
+            ALOGE("%s: the host's stream failed", __FUNCTION__);
+            mFailed = true;
+        } else if (kind == kFrame && len == 40 && fd.get() >= 0) {
+            HostFrameData frame{.id = u64At(bytes, 4),
+                                .timestamp = static_cast<nsecs_t>(u64At(bytes, 12)),
+                                .width = u32At(bytes, 20),
+                                .height = u32At(bytes, 24),
+                                .stride = u32At(bytes, 28),
+                                .offset = u32At(bytes, 32),
+                                .fd = std::move(fd)};
+            uint64_t size = u32At(bytes, 36);
+            if (frame.stride < uint64_t{frame.width} * 4 ||
+                size < uint64_t{frame.stride} * frame.height) {
+                ALOGE("%s: frame %" PRIu64 " is too small", __FUNCTION__, frame.id);
+                send(Message(kRelease).u64(frame.id).bytes());
+                continue;
+            }
+            if (mPending.has_value()) {
+                send(Message(kRelease).u64(mPending->id).bytes());
+            }
+            mPending = std::move(frame);
+        } else {
+            ALOGE("%s: unexpected message %u (%zd bytes)", __FUNCTION__, kind, len);
+            break;
+        }
+        mCond.notify_all();
+    }
+    std::lock_guard<std::mutex> lk(mLock);
+    mClosed = true;
+    mPending.reset();
+    mCond.notify_all();
+}
+
+HostError HostConnection::request(const std::vector<uint8_t>& message) {
+    std::unique_lock<std::mutex> lk(mLock);
+    mReplies.clear();
+    if (mClosed || !send(message)) {
+        return HostError::DISCONNECTED;
+    }
+    if (!mCond.wait_for(lk, kReplyTimeout, [this] { return mClosed || !mReplies.empty(); }) ||
+        mReplies.empty()) {
+        return HostError::DISCONNECTED;
+    }
+    HostError reply = mReplies.front();
+    mReplies.pop_front();
+    return reply;
+}
+
+HostError HostConnection::open(uint32_t camera) {
+    return request(Message(kOpen).u32(camera).bytes());
+}
+
+HostError HostConnection::start(uint32_t width, uint32_t height) {
+    {
+        std::lock_guard<std::mutex> lk(mLock);
+        mFailed = false;
+    }
+    return request(Message(kStart).u32(width).u32(height).bytes());
+}
+
+HostError HostConnection::stop() {
+    HostError reply = request(Message(kStop).bytes());
+    std::lock_guard<std::mutex> lk(mLock);
+    mPending.reset();
+    return reply;
+}
+
+std::optional<HostFrameData> HostConnection::nextFrame(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lk(mLock);
+    mCond.wait_for(lk, timeout, [this] { return mClosed || mFailed || mPending.has_value(); });
+    std::optional<HostFrameData> frame = std::move(mPending);
+    mPending.reset();
+    return frame;
+}
+
+void HostConnection::release(uint64_t id) {
+    send(Message(kRelease).u64(id).bytes());
+}
+
+void HostConnection::waitClosed() {
+    std::unique_lock<std::mutex> lk(mLock);
+    mCond.wait(lk, [this] { return mClosed; });
+}
+
+}  // namespace deckard
+}  // namespace camera
+}  // namespace hardware
+}  // namespace android
