From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 2 Nov 2026 18:04:21 +0000
Subject: [PATCH] device: Use Deckard's camera provider

The host's cameras come through android.hardware.camera.provider-V1-deckard-service
(hardware/deckard/camera) instead of the HIDL external provider, which
opened /dev/video* inside Android. Declare a back and a front camera
rather than full, raw and flash-autofocus features no camera has.
---
 configs/external_camera_config.xml | 77 ------------------------------
 device.mk                          | 14 ++----
 manifest.xml                       |  9 ----
 3 files changed, 3 insertions(+), 97 deletions(-)
 delete mode 100644 configs/external_camera_config.xml

diff --git a/configs/external_camera_config.xml b/configs/external_camera_config.xml
deleted file mode 100644
index 7b4a45d..0000000
--- a/configs/external_camera_config.xml
+++ /dev/null
@@ -1,77 +0,0 @@
-<!--
- Source:
- https://github.com/BlissOS/device_generic_common/blob/7096d60e36653744f9f55fd2f02ff115f0b49774/external_camera_config.xml
--->
-
-<ExternalCamera>
-    <Provider>
-        <ignore> <!-- Internal video devices to be ignored by external camera HAL -->
-            <!-- <id>0</id> -->
-            <!-- <id>1</id> -->
-        </ignore>
-    </Provider>
-    <!-- See ExternalCameraUtils.cpp for default values of Device configurations below -->
-    <Device>
-        <!-- Max JPEG buffer size in bytes-->
-        <MaxJpegBufferSize bytes="3145728"/> <!-- 3MB (~= 1080p YUV420) -->
-        <!-- Size of v4l2 buffer queue when streaming >= 30fps -->
-        <!-- Larger value: more request can be cached pipeline (less janky)  -->
-        <!-- Smaller value: use less memory -->
-        <NumVideoBuffers count="4"/>
-        <!-- Size of v4l2 buffer queue when streaming < 30fps -->
-        <NumStillBuffers count="2"/>
-
-        <!-- List of maximum fps for various output sizes -->
-        <!-- Any image size smaller than the size listed in Limit row will report
-            fps (as minimum frame duration) up to the fpsBound value. -->
-        <FpsList>
-            <!-- width/height must be increasing, fpsBound must be decreasing-->
-            <Limit  width="176" height="144" fpsBound="60.0" />
-            <Limit  width="176" height="144" fpsBound="30.0" />
-            <Limit  width="176" height="144" fpsBound="20.0" />
-            <Limit  width="176" height="144" fpsBound="15.0" />
