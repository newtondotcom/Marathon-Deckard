-</ExternalCamera>
diff --git a/device.mk b/device.mk
index bc65f94..879ff53 100644
--- a/device.mk
+++ b/device.mk
@@ -73,15 +73,9 @@ PRODUCT_COPY_FILES += \
     frameworks/av/services/audiopolicy/config/r_submix_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/r_submix_audio_policy_configuration.xml \
     frameworks/av/services/audiopolicy/config/usb_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/usb_audio_policy_configuration.xml
 
-# Camera
-USE_CAMERA_V4L2_HAL := true
-
+# Camera: the host's cameras through deckard-camera (hardware/deckard/camera)
 PRODUCT_PACKAGES += \
-    android.hardware.camera.provider@2.7-external-service \
-    camera.v4l2
-
-PRODUCT_COPY_FILES += \
-    $(LOCAL_PATH)/configs/external_camera_config.xml:$(TARGET_COPY_OUT_VENDOR)/etc/external_camera_config.xml
+    android.hardware.camera.provider-V1-deckard-service
 
 # The host schedules the disk with BFQ, which has io.bfq.weight, not io.weight
 PRODUCT_COPY_FILES += \
@@ -283,10 +277,8 @@ PRODUCT_COPY_FILES += \
