service vendor.camera.provider-deckard /vendor/bin/hw/android.hardware.camera.provider-V1-deckard-service
    interface aidl android.hardware.camera.provider.ICameraProvider/deckard/0
    class hal
    user cameraserver
    group audio camera input drmrpc usb
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
